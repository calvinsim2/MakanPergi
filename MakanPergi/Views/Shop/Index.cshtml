@using MakanPergi.Models.Shop
@{
}
@model ShopIndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}

<div class="container-fluid mt-4">
    <div class="container-fluid">
        <div class="d-flex flex-row justify-content-between">
            <div class="col-sm-6">
                <h3>Shop</h3>
            </div>
            <div class="d-flex flex-row justify-content-end">
                <button id="btnCreate" class="btn btn-primary m-1" type="button">
                    Create
                    <i class="fa fa-plus-square"></i>
                </button>
                </>
            </div>
        </div>

        <table id="shopTable" class="display mt-4 dt-custom-style">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Address)</th>
                    <th>@Html.DisplayNameFor(model => model.RegionName)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="ShopModalPlaceholder" role="dialog" data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script type="module" src="~/js/view/shop/index.js" asp-append-version="true"></script>
    <script type="module" src="~/js/view/shop/createShop.js" asp-append-version="true"></script>
    <script type="module" src="~/js/view/shop/editShop.js" asp-append-version="true"></script>
}