<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Cuisine Bulk Upload</h1>
            </div>
            <div class="col-sm-6">
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3>
                            <i class="fas fa-circle-info" style="color:orange"></i>
                            <b>Important Notes</b>
                        </h3>
                        <div class="callout callout-info col col-7">
                            <h4>For adding\updating cuisines:</h4>
                            <ol>
                                <li>Download the latest template from: <a href="@Url.Action("GetCuisineTemplate", "Cuisine")" style="color:blue">Here</a> </li>
                                <li>Edit the template with the required data</li>
                                <li>Keep the first row/header of the template</li>
                                <li>Adhere to the specified format</li>
                                <li>The data provided in the Excel file does not exceed 500 entries at once</li>
                            </ol>
                            @*<h4>For adding\updating staff profile image:</h4>
                            <ol>
                            <li>Put the images in .jpg or .png format into a folder</li>
                            <li>Rename them with the UIN number of the staff that is to be updated. I.e, S1234567A</li>
                            <li>Zip the whole folder</li>
                            <li>Select the zipped file using the 'Select File' button below and choose the 'Upload Image Zip File' button</li>
                            </ol>*@
                        </div>
                    </div>

                    <div id="Card" class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="row">
                                    <p id="FileName"></p>
                                </div>
                                <div class="row">
                                    <input id="Upload" type="file" accept=".xls,.xlsx, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel" hidden />
                                    <a id="SelectFileInput" class="btn bg-primary m-1">
                                        <i class="fa fa-file-excel" aria-hidden="true"></i>
                                        Select File
                                    </a>
                                    <a id="UploadExcelFileInput" class="btn btn-outline-info m-1">
                                        <i class="fa fa-upload" aria-hidden="true"></i>
                                        Upload Excel File
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div id="divUploadResult" class="row" style="display:none">
                            <div class="alert" id="alertMsg">
                                <h5 id="resultTitle">Title</h5>
                                <p id="resultText" class="mt-2">No errors</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    
}
