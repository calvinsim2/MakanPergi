{
  "version": "3.0",
  "defaultProvider": "unpkg",
  "libraries": [
    {
      "library": "@microsoft/signalr@latest",
      "destination": "wwwroot/lib/signalr"
    },
    {
      "provider": "jsdelivr",
      "library": "select2@4.0.13",
      "destination": "wwwroot/lib/select2/"
    },
    {
      "provider": "jsdelivr",
      "library": "toastr@2.1.4",
      "destination": "wwwroot/lib/toastr/"
    },
    {
      "provider": "jsdelivr",
      "library": "sweetalert2@11.26.25",
      "destination": "wwwroot/lib/sweetalert2/"
    },
    {
      "provider": "cdnjs",
      "library": "jquery.blockUI@2.70",
      "destination": "wwwroot/lib/jquery.blockUI/"
    },
    {
      "provider": "cdnjs",
      "library": "font-awesome@4.7.0",
      "destination": "wwwroot/lib/font-awesome/"
    },
    {
      "provider": "jsdelivr",
      "library": "jstree@3.3.12",
      "destination": "wwwroot/lib/jstree/"
