      "library": "datatables.net-dt@2.3.8",
      "destination": "wwwroot/lib/datatables.net-dt/"
    },
    {
      "provider": "jsdelivr",
      "library": "datatables.net-rowgroup-dt@1.6.0",
      "destination": "wwwroot/lib/datatables.net-rowgroup-dt/"
    },
    {
      "provider": "jsdelivr",
      "library": "datatables.net@2.3.8",
      "destination": "wwwroot/lib/datatables.net/"
    },
    {
      "provider": "jsdelivr",
      "library": "datatables.net-rowgroup@1.6.0",
      "destination": "wwwroot/lib/datatables.net-rowgroup/"
    }
  ]
